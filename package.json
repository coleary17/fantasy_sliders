{
  "name": "fantasy-slider",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prune-dist.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test lib/*.test.mjs lib/story/*.test.mjs src/story/*.test.mjs src/winprob/*.test.mjs",
    "collect": "node scripts/collect-local.mjs",
    "backfill": "node scripts/backfill-week.mjs",
    "story": "node --env-file-if-exists=.env.local scripts/generate-story.mjs",
    "story:index": "node scripts/index-stories.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@netlify/blobs": "^11.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4"
  }
}
